diff --git a/conversion/qwen.py b/conversion/qwen.py
index 83c844ce6..23b7f9400 100644
--- a/conversion/qwen.py
+++ b/conversion/qwen.py
@@ -707,6 +707,16 @@ class Qwen3_5TextModel(_Qwen35MRopeMixin, _LinearAttentionVReorderBase):
 
     def set_gguf_parameters(self):
         super().set_gguf_parameters()
+        # SWA variants (e.g. GDN-SWA-0.8B) replace the periodic full-attention layers with
+        # sliding-window attention. Upstream only exports full_attention_interval, so those
+        # layers would be loaded as dense attention and the KV cache would grow with context.
+        layer_types = self.hparams.get("layer_types") or []
+        is_swa = [t == "sliding_attention" for t in layer_types]
+        sliding_window = self.hparams.get("sliding_window")
+        if sliding_window and any(is_swa):
+            logger.info("qwen3.5: exporting sliding window %d with pattern %s", sliding_window, is_swa)
+            self.gguf_writer.add_sliding_window(sliding_window)
+            self.gguf_writer.add_sliding_window_pattern(is_swa)
         self._try_set_pooling_type()
 
 
